# Copy to .env and replace every placeholder before deployment.
QPHISH_AUTH_SECRET=replace-with-at-least-32-random-characters
QPHISH_AUTH_SECRET_FILE=/app/data/auth.secret
QPHISH_DATABASE_FILE=/app/data/qphish.db
QPHISH_MODEL_DIR=/app/models/url
QPHISH_QUANTUM_MODEL_FILE=/app/models/quantum_live.joblib
# Exact, clean root URLs for these domains receive legitimate hard-negative training.
QPHISH_TRUSTED_ROOT_DOMAINS=amazon.com,apple.com,github.com,google.com,microsoft.com,wikipedia.org,youtube.com
QPHISH_REQUIRE_HTTPS=true
QPHISH_ALLOWED_HOSTS=api.example.com
QPHISH_FRONTEND_ORIGINS=https://app.example.com
QPHISH_RATE_LIMIT_MAX_REQUESTS=120
QPHISH_RATE_LIMIT_WINDOW_SECONDS=60

# SMTP is used for email verification and password-reset messages.
QPHISH_SMTP_HOST=smtp.example.com
QPHISH_SMTP_PORT=587
QPHISH_SMTP_USERNAME=
QPHISH_SMTP_PASSWORD=
QPHISH_SMTP_FROM=security@example.com
QPHISH_REQUIRE_EMAIL_VERIFICATION=true
QPHISH_PUBLIC_API_URL=https://api.example.com

# PostgreSQL deployment (leave unset for local SQLite fallback).
DATABASE_URL=postgresql://qphish:replace-this-password@postgres:5432/qphish
POSTGRES_PASSWORD=replace-with-a-long-random-password
